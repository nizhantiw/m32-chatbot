# ============================================
#  BizPilot — Environment Variables
# ============================================

# Server port
PORT=3001

# Node environment (development | production)
NODE_ENV=development

# JWT secrets — change these to long random strings in production
JWT_SECRET=bizpilot-jwt-secret-change-me-in-production
JWT_REFRESH_SECRET=bizpilot-refresh-secret-change-me-in-production

# ─── AI ─────────────────────────────────────
# Google Gemini API key (https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Gemini model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ─── Web Search ──────────────────────────────
# Tavily API key — free tier at https://tavily.com (1000 searches/month)
TAVILY_API_KEY=your-tavily-api-key

# ─── Observability ───────────────────────────
# Langfuse (optional) — free at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Google OAuth (optional bonus) ───────────
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── Client ──────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Database ────────────────────────────────
# SQLite local path (relative to packages/server)
DB_PATH=./bizpilot.db
